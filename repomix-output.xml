name: Expo Doctor (expo)

on:
  push:
    branches:
      - main
      - master
    paths:
      - package.json
      - pnpm-lock.yaml
  pull_request:
    paths:
      - package.json
      - pnpm-lock.yaml

permissions:
  contents: read
  pull-requests: write

jobs:
