# Application Environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# App Identity
EXPO_PUBLIC_NAME=SnapVocab Dev
EXPO_PUBLIC_SCHEME=snapvocab-dev
EXPO_PUBLIC_BUNDLE_ID=com.snapvocab.dev
EXPO_PUBLIC_PACKAGE=com.snapvocab.dev

# API
# 1. Android Emulator (mặc định)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# 2. iOS Simulator hoặc Web browser
# EXPO_PUBLIC_API_URL=http://localhost:8080

# 3. Thiết bị thật (cùng mạng Wi-Fi với máy tính - thay bằng IP máy tính của bạn)
# EXPO_PUBLIC_API_URL=http://192.168.1.52:8080

EXPO_PUBLIC_ASSOCIATED_DOMAIN=

